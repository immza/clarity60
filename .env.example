# Copy to .env for local development. Real values live in DigitalOcean / GitHub settings.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/clarity60
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error monitoring (Sentry). The DSN is public by design; leave empty locally to stay quiet.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for readable stack traces. Create in Sentry: Settings → Auth Tokens. Never commit.
SENTRY_AUTH_TOKEN=

# Analytics (GA4 Measurement ID, e.g. G-XXXXXXX). Empty = no analytics and no cookie banner.
NEXT_PUBLIC_GA_ID=
# IndexNow key (any 32-hex string); empty = no pings.
INDEXNOW_KEY=
